# Copy to .env and edit. All optional.
PORT=3000
# docker (default, sandboxed) | local (NO sandbox, admin-only testing) | off
RUNNER=docker
RUNNER_IMAGE=hakrathon-runner:latest
# How many code runs at once (protects this computer)
RUNNER_CONCURRENCY=3

# Optional "Sign in with GitHub": create an OAuth app at https://github.com/settings/developers
# Callback URL must be  <PUBLIC_URL>/api/auth/github/callback
# PUBLIC_URL=https://your-ngrok-name.ngrok-free.app
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional: lets the portal snapshot PRIVATE team repos (fine-grained token, read-only Contents)
# GITHUB_TOKEN=
